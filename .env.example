# Copy to .env and fill in. Never commit real secrets.

# LLM (OpenAI-compatible). Prefer OPENAI_API_KEY when set; else OPENROUTER_API_KEY.
# LLM_MODE=stub for offline/tests; litellm for live OpenRouter/OpenAI routing.
LLM_MODE=stub
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
OPENAI_MODEL=
LLM_API_BASE=https://openrouter.ai/api/v1

# Data plane
DATABASE_URL=postgresql+asyncpg://agentsuite:agentsuite@127.0.0.1:5432/agentsuite
DATABASE_URL_SYNC=postgresql://agentsuite:agentsuite@127.0.0.1:5432/agentsuite
REDIS_URL=redis://127.0.0.1:6379/0
TEMPORAL_HOST=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agentsuite-main

# Paths
FIXTURES_DIR=data/fixtures
TEMPLATES_DIR=templates/agents
GENERATED_DIR=data/generated

# GitHub (App preferred; PAT fallback)
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_BOT_LOGIN=
CONNECTED_SYSTEM_GITHUB_MCP_ENABLED=true
CONNECTED_SYSTEM_GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
CONNECTED_SYSTEM_GITHUB_MCP_TOOLSETS=pull_requests,repos,issues,actions
GITHUB_REVIEW_SPEC_ID=
GITHUB_ISSUE_SPEC_ID=
GITHUB_MENTION_SPEC_ID=
GITHUB_CICD_SPEC_ID=
GITHUB_CICD_AUTHOR_SPEC_ID=

# Jira / Atlassian MCP
CONNECTED_SYSTEM_JIRA_MCP_ENABLED=true
CONNECTED_SYSTEM_JIRA_MCP_URL=https://mcp.atlassian.com/v1/mcp
ATLASSIAN_MCP_TOKEN=
ATLASSIAN_EMAIL=
ATLASSIAN_CLOUD_ID=
JIRA_WEBHOOK_SECRET=
JIRA_BOT_ACCOUNT_ID=
JIRA_BOT_EMAIL=

# Gmail / Calendar (native OAuth)
CONNECTED_SYSTEM_GMAIL_ENABLED=true
CONNECTED_SYSTEM_CALENDAR_ENABLED=true
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=
GMAIL_WORKSPACE_DOMAIN=
GMAIL_WEBHOOK_SECRET=
GMAIL_PUBSUB_TOPIC=
GMAIL_WATCH_LABEL_IDS=INBOX
GMAIL_WATCH_RENEW_HOURS=24
GMAIL_TRIAGE_SPEC_ID=
HIRE_ONBOARDING_SPEC_ID=
RESUME_INSIGHTS_SPEC_ID=

# API / tunnel
API_HOST=127.0.0.1
API_PORT=8000
OFFLINE_DEMO_MODE=true

# Smoke targets
SMOKE_GITHUB_OWNER=
SMOKE_GITHUB_REPO=
SMOKE_GITHUB_APP_REPO=
SMOKE_GITHUB_PR_NUMBER=
SMOKE_JIRA_PROJECT_KEY=
