# Copy to .env and fill in. Never commit real secrets.

# GitHub (App preferred; PAT fallback)
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
CONNECTED_SYSTEM_GITHUB_MCP_ENABLED=true
CONNECTED_SYSTEM_GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
CONNECTED_SYSTEM_GITHUB_MCP_TOOLSETS=pull_requests,repos,issues,actions
SMOKE_GITHUB_OWNER=
SMOKE_GITHUB_REPO=

# Jira / Atlassian MCP
CONNECTED_SYSTEM_JIRA_MCP_ENABLED=true
CONNECTED_SYSTEM_JIRA_MCP_URL=https://mcp.atlassian.com/v1/mcp
ATLASSIAN_MCP_TOKEN=
# JIRA_MCP_TOKEN=
ATLASSIAN_EMAIL=
ATLASSIAN_CLOUD_ID=
JIRA_WEBHOOK_SECRET=
SMOKE_JIRA_PROJECT_KEY=

# Gmail / Calendar (native OAuth)
CONNECTED_SYSTEM_GMAIL_ENABLED=true
CONNECTED_SYSTEM_CALENDAR_ENABLED=true
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=
GMAIL_WEBHOOK_SECRET=
GMAIL_PUBSUB_TOPIC=
GMAIL_WATCH_LABEL_IDS=INBOX

# LLM (OpenAI-compatible). Prefer OPENAI_API_KEY when set; else OPENROUTER_API_KEY.
# Empty OPENAI_API_KEY + set OpenRouter key still enables Director / synthesizer / Agents SDK.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# OpenAI-compatible base URL (OpenRouter: https://openrouter.ai/api/v1)
LLM_API_BASE=
# Model id (OpenRouter examples: openai/gpt-4o-mini ; OpenAI: gpt-4.1-mini)
OPENAI_MODEL=
LLM_MODEL=

# API / tunnel
API_HOST=127.0.0.1
API_PORT=8000
GENERATED_DIR=data/generated
OFFLINE_DEMO_MODE=true

# Data plane / orchestration (docker compose defaults)
DATABASE_URL=postgresql+asyncpg://agentsuite:agentsuite@127.0.0.1:5432/agentsuite
DATABASE_URL_SYNC=postgresql://agentsuite:agentsuite@127.0.0.1:5432/agentsuite
REDIS_URL=redis://127.0.0.1:6379/0
TEMPORAL_HOST=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agentsuite-main

# Smoke targets
# Primary: issue creates (often works even when App install is partial)
SMOKE_GITHUB_OWNER=n1shanthb
SMOKE_GITHUB_REPO=analytics-resume
# App-installed repo for PR review / CI workflow writes (owner/repo)
SMOKE_GITHUB_APP_REPO=n1shanthb/nalvis-landing
# Open PR on the App repo for github.review_pr
SMOKE_GITHUB_PR_NUMBER=15
SMOKE_JIRA_PROJECT_KEY=SCRUM
